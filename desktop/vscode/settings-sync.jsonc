// VS Code user settings for a Desktop. Paste these keys into the user
// settings.json once; Settings Sync then carries them to every Desktop.
// remote.SSH.defaultExtensions: installed on each Server at connect time (the
// list matches server-extensions.txt; bin/vscode-server-extensions is the
// fallback run from a VS Code-connected terminal on the Server).
{
  "remote.SSH.defaultExtensions": [
    "anthropic.claude-code",
    "charliermarsh.ruff",
    "cweijan.vscode-office",
    "eamodio.gitlens",
    "llvm-vs-code-extensions.vscode-clangd",
    "ms-ceintl.vscode-language-pack-zh-hant",
    "ms-python.debugpy",
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.vscode-python-envs",
    "ms-vscode.makefile-tools",
    "oderwat.indent-rainbow",
    "openai.chatgpt",
    "openai.codex-audio",
    "tamasfe.even-better-toml"
  ],
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font"
}
