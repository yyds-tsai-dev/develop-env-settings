{{- /* Windows (the Desktop role; Server use goes through WSL2). PowerShell twin
of run_onchange_after_50-claude.sh. */ -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $cbm := index .versions "codebase-memory-mcp" | default "" -}}
# Claude Code: the official native installer (user scope, no admin) when
# missing, codebase-memory-mcp via its upstream install.ps1 (binary only, then
# `codebase-memory-mcp install --clients=claude` writes its hooks, agents and
# skill), third-party skills, marketplaces and plugins from the Manifest,
# user-scope MCP servers at locked versions, then re-applies
# ~/.claude/settings.json because the cbm installer and
# `claude plugin marketplace add` rewrite it. Never logs in (Doctor checks the
# login). Never aborts apply.
# Only the MCP servers whose command exists here are registered, and an
# installer-made skill is installed only when its installer exists; each one
# skipped prints one warning and is not a failure (no retry marker). A server
# whose command is a .cmd/.ps1 shim (npx from a Node install) is registered as
# `cmd /c <command> ...`, since Claude Code cannot start a shim directly. Before
# registering, a uvx server is run once with --help (no uv tools here) and an
# npx server once with an empty stdin, so the first start finds the package
# cached and fits in Claude's 30 s connect timeout. Any other
# warning leaves a retry marker with a fresh nonce, so the next apply (re-run
# the bootstrap one-liner) reruns this after every failed run; a clean run
# removes it.
{{ template "retry-marker" (dict "chezmoi" .chezmoi "name" "50-claude") }}
# Locks: codebase-memory-mcp={{ $cbm }} graphifyy={{ index .versions "graphifyy" | default "" }}
# Codex bundle locks (a changed one re-runs this script so installed plugins are updated):{{ range .codex.skill_bundles }} {{ .name }}={{ index $.versions .name | default .ref }}{{ end }}
# Claude skill bundle locks:{{ range (index .claude "skill_bundles" | default list) }} {{ .name }}={{ index $.versions .name | default "" }}{{ end }}
$ErrorActionPreference = 'Continue'
$ProgressPreference = 'SilentlyContinue'
[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
{{ template "retry-ps1" "50-claude" }}
$script:failed = $false
function Warn-Step([string]$Message) { Write-Warning $Message; $script:failed = $true }
# Skip-Step: this desktop lacks the runtime; not a failure.
function Skip-Step([string]$Message) { Write-Warning $Message }
function Test-Cmd([string]$Name) { [bool](Get-Command $Name -ErrorAction SilentlyContinue) }
# Get-Script URL: download URL to a temp .ps1 and return its path, or $null.
function Get-Script([string]$Url) {
    $f = Join-Path ([IO.Path]::GetTempPath()) ('devenv-' + [guid]::NewGuid() + '.ps1')
    try {
        Invoke-WebRequest -UseBasicParsing -TimeoutSec 120 -Uri $Url -OutFile $f
        return $f
    } catch {
        Remove-Item -Force -ErrorAction SilentlyContinue $f
        return $null
    }
}

$bin = Join-Path $HOME '.local\bin'
$env:Path = $bin + [IO.Path]::PathSeparator + $env:Path
Set-Location $HOME

# --- Claude Code (native installer, latest; it updates itself) ---
# The file form of `irm https://claude.ai/install.ps1 | iex`, so the installer's
# own `exit` cannot end this script.
function Test-Claude {
    if (-not (Test-Cmd 'claude')) { return $false }
    & claude --version *> $null
    return ($LASTEXITCODE -eq 0)
}
if (-not (Test-Claude)) {
    $inst = Get-Script 'https://claude.ai/install.ps1'
    if ($inst) {
        & powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File $inst
        if ($LASTEXITCODE -ne 0) { Warn-Step 'Claude Code native install failed' }
        Remove-Item -Force -ErrorAction SilentlyContinue $inst
    } else {
        Warn-Step 'could not download the Claude Code installer (https://claude.ai/install.ps1)'
    }
}
$claudeOk = Test-Claude
if (-not $claudeOk) { Warn-Step 'claude missing; skipping plugins and MCP servers' }

# --- codebase-memory-mcp (upstream installer pinned to the lock) ---
# install.ps1 has no --clients: it installs the binary into ~/.local/bin with
# --skip-config, then the binary configures Claude only (Codex is not on a
# Desktop). Its hooks and MCP registration are put back below.
$cbmVersion = '{{ $cbm }}'
$cbmHave = ''
if (Test-Cmd 'codebase-memory-mcp') { $cbmHave = "$(& codebase-memory-mcp --version 2>$null)".Trim() }
if (($cbmHave -ne "codebase-memory-mcp $cbmVersion") -and ($cbmVersion -or -not (Test-Cmd 'codebase-memory-mcp'))) {
    if ($cbmVersion) {
        $ref = "v$cbmVersion"; $dl = "https://github.com/DeusData/codebase-memory-mcp/releases/download/v$cbmVersion"
    } else {
        $ref = 'main'; $dl = 'https://github.com/DeusData/codebase-memory-mcp/releases/latest/download'
    }
    $inst = Get-Script "https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/$ref/install.ps1"
    if ($inst) {
        $env:CBM_DOWNLOAD_URL = $dl
        & powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File $inst "--dir=$bin" --skip-config
        $rc = $LASTEXITCODE
        Remove-Item Env:CBM_DOWNLOAD_URL -ErrorAction SilentlyContinue
        Remove-Item -Force -ErrorAction SilentlyContinue $inst
        $cbmExe = Join-Path $bin 'codebase-memory-mcp.exe'
        if ($rc -ne 0 -or -not (Test-Path $cbmExe)) {
            Warn-Step "codebase-memory-mcp $cbmVersion install failed"
        } else {
            & $cbmExe install -y --skip-binary --clients=claude "--dir=$bin"
            if ($LASTEXITCODE -ne 0) { Warn-Step 'codebase-memory-mcp could not configure Claude Code' }
        }
    } else {
        Warn-Step "could not download the codebase-memory-mcp $ref installer"
    }
}

# --- third-party skills ---
# Get-Skill DIR URL: install URL as ~/.claude/skills/DIR/SKILL.md
function Get-Skill([string]$Dir, [string]$Url) {
    $dst = Join-Path $HOME ".claude\skills\$Dir\SKILL.md"
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('devenv-skill-' + [guid]::NewGuid())
    try {
        Invoke-WebRequest -UseBasicParsing -TimeoutSec 120 -Uri $Url -OutFile $tmp
        New-Item -ItemType Directory -Force -Path (Split-Path $dst) | Out-Null
        if (-not (Test-Path $dst) -or (Get-FileHash $tmp).Hash -ne (Get-FileHash $dst).Hash) {
            Copy-Item -Force $tmp $dst
        }
    } catch {
        Warn-Step "could not download skill $Dir from ${Url}: $_"
    }
    Remove-Item -Force -ErrorAction SilentlyContinue $tmp
}
{{- range .claude.skills }}
{{- if index . "url" }}
{{- $v := index $.versions (index . "version_from" | default .name) }}
{{- $ref := "main" }}{{ if $v }}{{ $ref = printf "v%s" $v }}{{ end }}
Get-Skill {{ .dir | squote }} {{ replace "{ref}" $ref .url | squote }}
{{- else if eq (index . "installer" | default "") "graphify" }}
if (Test-Cmd 'graphify') {
    # CLAUDE_CONFIG_DIR: graphify also writes its block into CLAUDE.md, which chezmoi
    # manages; install into a scratch dir and keep only the skill.
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('devenv-graphify-' + [guid]::NewGuid())
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null
    $env:CLAUDE_CONFIG_DIR = $tmp
    & graphify install *> $null
    $rc = $LASTEXITCODE
    Remove-Item Env:CLAUDE_CONFIG_DIR -ErrorAction SilentlyContinue
    if ($rc -eq 0 -and (Test-Path (Join-Path $tmp 'skills\graphify\SKILL.md'))) {
        $dst = Join-Path $HOME '.claude\skills\graphify'
        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $dst
        New-Item -ItemType Directory -Force -Path $dst | Out-Null
        Copy-Item -Recurse -Force (Join-Path $tmp 'skills\graphify\*') $dst
    } else {
        Warn-Step 'graphify install failed'
    }
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $tmp
} else {
    Skip-Step 'graphify not installed on this desktop; skipping the graphify skill'
}
{{- end }}
{{- end }}

# --- Claude skill bundles (allowlisted skills and agents from a repo tarball) ---
# Install-ClaudeBundle: as cbundle in the sh twin. Copies each allowlisted
# SkillsDir\<skill>\ to ~/.claude/skills/<skill>/ and AgentsDir\<agent>.md to
# ~/.claude/agents/, records them in ~/.local/state/develop-env/claude-bundles/<Name>
# ("version V", "skill N", "agent N"), removes only recorded entries that left
# the allowlist, moves an unrecorded differing target to ~/.claude/.devenv-replaced\
# first, and never writes the repo's own agents. Nothing is fetched when the
# record already matches.
{{- $own := list }}
{{- range glob (joinPath .chezmoi.sourceDir "dot_claude/agents/*") }}{{ $own = append $own (base . | trimSuffix ".tmpl" | trimSuffix ".md") }}{{ end }}
$ownAgents = @({{ range $i, $a := $own }}{{ if $i }}, {{ end }}{{ $a | squote }}{{ end }})
$cbState = Join-Path $HOME '.local\state\develop-env\claude-bundles'
# Windows' own tar (bsdtar, System32) handles drive paths; elsewhere (no
# SystemRoot, e.g. the PowerShell tests on Linux) the tar on PATH.
$cbTar = 'tar'
if ($env:SystemRoot -and (Test-Path (Join-Path $env:SystemRoot 'System32\tar.exe'))) { $cbTar = Join-Path $env:SystemRoot 'System32\tar.exe' }
# Test-SameTree A B: the two files, or the two dirs' file sets and contents, are identical.
function Test-SameTree([string]$A, [string]$B) {
    if (-not (Test-Path -LiteralPath $B)) { return $false }
    if (-not (Test-Path -LiteralPath $A -PathType Container)) {
        return (Test-Path -LiteralPath $B -PathType Leaf) -and (Get-FileHash -LiteralPath $A).Hash -eq (Get-FileHash -LiteralPath $B).Hash
    }
    $ha = @(Get-ChildItem -LiteralPath $A -Recurse -File | ForEach-Object { $_.FullName.Substring($A.Length) + ' ' + (Get-FileHash -LiteralPath $_.FullName).Hash } | Sort-Object)
    $hb = @(Get-ChildItem -LiteralPath $B -Recurse -File | ForEach-Object { $_.FullName.Substring($B.Length) + ' ' + (Get-FileHash -LiteralPath $_.FullName).Hash } | Sort-Object)
    return (($ha -join "`n") -eq ($hb -join "`n"))
}
function Install-ClaudeBundleEntry([string]$Src, [string]$Dst, [string]$Entry, [string[]]$Old) {
    if (Test-Path -LiteralPath $Dst) {
        if (Test-SameTree $Src $Dst) { return $true }
        if ($Old -notcontains $Entry) {
            $aside = Join-Path $HOME '.claude\.devenv-replaced'
            try {
                New-Item -ItemType Directory -Force -Path $aside | Out-Null
                Move-Item -LiteralPath $Dst (Join-Path $aside ((Split-Path -Leaf $Dst) + '.' + (Get-Date -Format 'yyyyMMddHHmmss')))
            } catch { Warn-Step "cannot move $Dst aside: $_"; return $false }
        }
    }
    try {
        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue -LiteralPath $Dst
        Copy-Item -Recurse -Force -LiteralPath $Src -Destination $Dst -ErrorAction Stop
        return $true
    } catch { Warn-Step "cannot install ${Dst}: $_"; return $false }
}
function Install-ClaudeBundle([string]$Name, [string]$Repo, [string]$Ref, [string]$Version,
                              [string]$SkillsDir, [string]$AgentsDir, [string[]]$Skills, [string[]]$Agents) {
    $st = Join-Path $cbState $Name
    $old = @()
    if (Test-Path $st) { $old = @(Get-Content $st) }
    $want = @("version $Version") + @($Skills | ForEach-Object { "skill $_" }) + @($Agents | ForEach-Object { "agent $_" })
    $sk = Join-Path $HOME '.claude\skills'; $ag = Join-Path $HOME '.claude\agents'
    if (($old -join "`n") -eq ($want -join "`n")) {
        $ok = $true
        foreach ($x in $Skills) { if (-not (Test-Path (Join-Path $sk "$x\SKILL.md"))) { $ok = $false } }
        foreach ($x in $Agents) { if (-not (Test-Path (Join-Path $ag "$x.md"))) { $ok = $false } }
        if ($ok) { return }
    }
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('devenv-cb-' + [guid]::NewGuid())
    $tgz = "$tmp.tgz"
    try {
        New-Item -ItemType Directory -Force -Path $tmp | Out-Null
        Invoke-WebRequest -UseBasicParsing -TimeoutSec 300 -Uri "https://codeload.github.com/$Repo/tar.gz/$Ref" -OutFile $tgz
        & $cbTar -xzf $tgz -C $tmp --strip-components=1
        if ($LASTEXITCODE -ne 0) { throw "tar exit $LASTEXITCODE" }
    } catch {
        Warn-Step "could not fetch $Repo at ${Ref}: $_"
        Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $tmp, $tgz
        return
    }
    New-Item -ItemType Directory -Force -Path $sk, $ag | Out-Null
    $new = @("version $Version")
    foreach ($x in $Skills) {
        $src = Join-Path $tmp "$SkillsDir\$x"
        if (-not (Test-Path (Join-Path $src 'SKILL.md'))) { Warn-Step "bundle $Name has no skill $SkillsDir/$x"; continue }
        if (Install-ClaudeBundleEntry $src (Join-Path $sk $x) "skill $x" $old) { $new += "skill $x" }
    }
    foreach ($x in $Agents) {
        if ($ownAgents -contains $x) { Warn-Step "bundle ${Name}: agent $x is one of this repo's own agents; not installed"; continue }
        $src = Join-Path $tmp "$AgentsDir\$x.md"
        if (-not (Test-Path $src)) { Warn-Step "bundle $Name has no agent $AgentsDir/$x.md"; continue }
        if (Install-ClaudeBundleEntry $src (Join-Path $ag "$x.md") "agent $x" $old) { $new += "agent $x" }
    }
    # recorded entries that left the allowlist (and only those) are removed
    foreach ($l in $old) {
        $k, $x = $l -split ' ', 2
        if ($k -eq 'skill' -and $Skills -notcontains $x) { Remove-Item -Recurse -Force -ErrorAction SilentlyContinue -LiteralPath (Join-Path $sk $x) }
        if ($k -eq 'agent' -and $Agents -notcontains $x -and $ownAgents -notcontains $x) { Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath (Join-Path $ag "$x.md") }
    }
    try {
        New-Item -ItemType Directory -Force -Path $cbState | Out-Null
        [IO.File]::WriteAllText($st, (($new -join "`n") + "`n"), (New-Object Text.UTF8Encoding $false))
    } catch { Warn-Step "cannot write ${st}: $_" }
    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $tmp, $tgz
}
{{- range (index .claude "skill_bundles" | default list) }}
{{- $v := index $.versions .name | default "" }}
{{- if and (contains "{version}" .ref) (not $v) }}
Warn-Step {{ printf "%s: no locked version; skipped (re-run the bootstrap one-liner)" .name | squote }}
{{- else }}
Install-ClaudeBundle {{ .name | squote }} {{ .repo | squote }} {{ replace "{version}" $v .ref | squote }} {{ $v | squote }} {{ .skills_dir | squote }} {{ .agents_dir | squote }} @({{ range $i, $x := (index . "skills" | default list) }}{{ if $i }}, {{ end }}{{ $x | squote }}{{ end }}) @({{ range $i, $x := (index . "agents" | default list) }}{{ if $i }}, {{ end }}{{ $x | squote }}{{ end }})
{{- end }}
{{- end }}

if ($claudeOk) {
    # --- marketplaces and plugins ---
    $mkts = (& claude plugin marketplace list --json 2>$null) -join "`n"
{{- range .claude.marketplaces }}
    if (-not $mkts.Contains('"name": "{{ .name }}"')) {
        & claude plugin marketplace add {{ .repo | squote }}
        if ($LASTEXITCODE -ne 0) { Warn-Step 'could not add marketplace {{ .name }}' }
    }
    & claude plugin marketplace update {{ .name | squote }}
    if ($LASTEXITCODE -ne 0) { Warn-Step 'could not update marketplace {{ .name }}' }
{{- end }}
    $plugins = (& claude plugin list --json 2>$null) -join "`n"
{{- range .claude.plugins }}
    if ($plugins.Contains('"id": "{{ .name }}"')) {
        & claude plugin update {{ .name | squote }}
        if ($LASTEXITCODE -ne 0) { Warn-Step 'could not update plugin {{ .name }}' }
    } else {
        & claude plugin install {{ .name | squote }}
        if ($LASTEXITCODE -ne 0) { Warn-Step 'could not install plugin {{ .name }}' }
    }
{{- end }}

    # --- MCP servers (user scope) ---
    # Set-McpServer NAME COMMAND [ARG]...: register unless `claude mcp get` already
    # shows the same command and args; a different registration is replaced.
    # The argument lists are splatted so `--` reaches claude unchanged.
    function Set-McpServer([string]$Name, [string[]]$CommandLine) {
        $got = @(& claude mcp get $Name 2>$null)
        if ($LASTEXITCODE -ne 0) { $got = @() }
        $cmd = ''; $cmdArgs = ''
        foreach ($l in $got) {
            if ($l -match '^\s*Command: (.*)$') { $cmd = $Matches[1].Trim() }
            elseif ($l -match '^\s*Args:\s*(.*)$') { $cmdArgs = $Matches[1].Trim() }
        }
        $have = $cmd; if ($cmdArgs) { $have = "$cmd $cmdArgs" }
        if ($cmd -and $have -eq ($CommandLine -join ' ')) { return }
        if ($got.Count -gt 0) { $rm = @('mcp', 'remove', '-s', 'user', $Name); & claude @rm *> $null }
        $add = @('mcp', 'add', '-s', 'user', $Name, '--') + $CommandLine
        & claude @add *> $null
        if ($LASTEXITCODE -ne 0) { Warn-Step "could not add MCP server $Name" }
    }
    # Get-McpCommandLine COMMAND [ARG]...: the command line to register; a .cmd,
    # .bat or .ps1 shim runs through `cmd /c`.
    function Get-McpCommandLine([string[]]$CommandLine) {
        $src = (Get-Command $CommandLine[0] -ErrorAction SilentlyContinue).Source
        # Windows: anything but an .exe (npx.cmd, a .ps1 shim) runs through cmd /c
        if ($src -match '\.(cmd|bat|ps1)$' -or ($env:OS -eq 'Windows_NT' -and $src -notmatch '\.exe$')) { return @('cmd', '/c') + $CommandLine }
        return $CommandLine
    }
    # Invoke-Prewarm help|stdin COMMAND [ARG]...: run the server command once,
    # with --help (uvx: uv fetches Python and the package) or as is with an
    # empty stdin (an MCP stdio server exits at end of input; npx caches the
    # package), 15 min cap.
    function Invoke-Prewarm([string]$Mode, [string[]]$CommandLine) {
        $argList = @($CommandLine | Select-Object -Skip 1)
        if ($Mode -eq 'help') { $argList += '--help' }
        try {
            # System.Diagnostics.Process, not Start-Process: stdin is closed
            # without writing to it, and ExitCode is reliable on PowerShell 5.1.
            $psi = New-Object Diagnostics.ProcessStartInfo
            $psi.FileName = (Get-Command $CommandLine[0] -ErrorAction Stop).Source
            $psi.Arguments = $argList -join ' '
            $psi.UseShellExecute = $false
            $psi.RedirectStandardInput = $true
            $psi.RedirectStandardOutput = $true
            $psi.RedirectStandardError = $true
            $p = [Diagnostics.Process]::Start($psi)
            $p.BeginOutputReadLine(); $p.BeginErrorReadLine()   # discarded
            try { $p.StandardInput.Close() } catch { }          # it may have exited already
            if (-not $p.WaitForExit(900000)) { $p.Kill(); throw 'timed out after 15 minutes' }
            $p.WaitForExit()
            if ($p.ExitCode -ne 0) { throw "exit code $($p.ExitCode)" }
        } catch {
            Warn-Step "could not pre-fetch the MCP server command $($CommandLine -join ' '): $_"
        }
    }
{{- range .mcp }}
{{- if has "claude" .clients }}
{{- $v := index $.versions .name }}
    if (-not (Test-Cmd {{ .command | squote }})) {
        Skip-Step '{{ .command }} not found on this desktop; skipping MCP server {{ trimPrefix "mcp-" .name }}'
    } else {
        $cl = @({{ .command | squote }}
{{- range .args }}, {{ if $v }}{{ replace "{version}" $v . | squote }}{{ else }}{{ . | replace "=={version}" "" | replace "@{version}" "@latest" | squote }}{{ end }}{{ end }})
        $cl = Get-McpCommandLine $cl
{{- if eq .command "uvx" }}
        Invoke-Prewarm help $cl
{{- else if eq .command "npx" }}
        Invoke-Prewarm stdin $cl
{{- end }}
        Set-McpServer {{ trimPrefix "mcp-" .name | squote }} $cl
    }
{{- end }}
{{- end }}

    # --- ARIS (aris@aris): its `codex` reviewer MCP server and ~/.aris/repo ---
    # What the plugin's /aris:setup does. The plugin root is a versioned cache
    # dir, so every run re-registers server.py from the current installPath
    # (the sh twin uses the aris-codex-mcp wrapper instead) and re-points
    # ~/.aris/repo unless it names an ARIS clone outside the plugin cache.
    # Python 3.9+: python3 or python (.exe), else uv's 3.12 (installed when missing).
    $arisRoot = ''
    try {
        $reg = Get-Content -Raw -ErrorAction Stop (Join-Path $HOME '.claude\plugins\installed_plugins.json') | ConvertFrom-Json
        $arisRoot = "$(@($reg.plugins.'aris@aris')[0].installPath)"
    } catch { }
    $arisSrv = if ($arisRoot) { Join-Path $arisRoot 'mcp-servers\codex-exec\server.py' } else { '' }
    if (-not $arisSrv -or -not (Test-Path $arisSrv)) {
        Warn-Step 'aris@aris is not installed (no mcp-servers\codex-exec\server.py); skipping its codex MCP server'
    } else {
        $arisFile = Join-Path $HOME '.aris\repo'
        $arisCur = ''
        if (Test-Path $arisFile) { $arisCur = "$(Get-Content -Raw $arisFile)".Trim() }
        $arisCache = Join-Path $HOME '.claude\plugins\cache\aris\'
        if ($arisCur -ne $arisRoot -and (-not $arisCur -or $arisCur.StartsWith($arisCache, [StringComparison]::OrdinalIgnoreCase) -or -not (Test-Path $arisCur))) {
            New-Item -ItemType Directory -Force -Path (Split-Path $arisFile) | Out-Null
            [IO.File]::WriteAllText($arisFile, "$arisRoot`n", (New-Object Text.UTF8Encoding $false))
        }
        $py = ''
        foreach ($c in @('python3', 'python')) {
            $src = (Get-Command $c -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1).Source
            # on Windows only an .exe (python3.exe may be the Store alias stub, which fails the check)
            if ($src -and ($src -match '\.exe$' -or $env:OS -ne 'Windows_NT')) {
                & $src -c 'import sys; sys.exit(sys.version_info < (3, 9))' *> $null
                if ($LASTEXITCODE -eq 0) { $py = $src; break }
            }
        }
        if (-not $py -and (Test-Cmd 'uv')) {
            $py = "$(& uv python find 3.12 2>$null)".Trim()
            if (-not $py) {
                & uv python install 3.12 *> $null
                $py = "$(& uv python find 3.12 2>$null)".Trim()
            }
        }
        if ($py) { Set-McpServer 'codex' @($py, $arisSrv) }
        else { Warn-Step 'no python3 3.9+ and uv could not install Python 3.12; skipping the ARIS codex MCP server' }
    }
}

# --- settings.json: the exact file chezmoi manages ---
$settings = Join-Path $HOME '.claude\settings.json'
$want = @'
{{ template "claude-settings.json" . -}}
'@
$want = ($want -replace "`r`n", "`n") + "`n"
$cur = $null
if (Test-Path $settings) { $cur = [IO.File]::ReadAllText($settings) }
if ($cur -ne $want) {
    try {
        New-Item -ItemType Directory -Force -Path (Split-Path $settings) | Out-Null
        [IO.File]::WriteAllText($settings, $want, (New-Object Text.UTF8Encoding $false))
    } catch { Warn-Step "could not write ${settings}: $_" }
}

if ($script:failed) {
    Set-RetryMarker
    Write-Warning '50-claude had failures; re-running the bootstrap one-liner retries it'
} else {
    Clear-RetryMarker
}
exit 0
{{- end }}
