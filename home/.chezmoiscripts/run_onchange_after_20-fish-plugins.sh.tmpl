{{- if .isServer -}}
#!/bin/sh
# Installs fisher, syncs fish_plugins, then reproduces the captured tide prompt.
# Reruns when the plugin list or this script changes.
# fish_plugins: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
# Never aborts apply: failures print a warning and exit 0.
PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"   # Homebrew fish/tmux (12-mac-cli-tools)
{{- end }}
export PATH

warn() { echo "warning: $*" >&2; }

if ! command -v fish >/dev/null 2>&1; then
    warn "fish is not installed yet; skipping fisher and tide setup"
    exit 0
fi

fish -c 'functions -q fisher; or begin
    curl -fsSL --max-time 30 https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    and fisher install jorgebucaran/fisher
end' || { warn "fisher install failed; skipping fish plugins and tide"; exit 0; }
fish -c 'fisher update' || { warn "fisher update failed; skipping tide"; exit 0; }

# Flags reproduce the tide_* universal variables captured from the old host:
# Classic style, dark true-colour bars, slanted separators, sharp heads, flat tails,
# two-line prompt with a character line, right frame, many icons, transient prompt.
fish -c 'tide configure --auto --style=Classic --prompt_colors="True color" \
    --classic_prompt_color=Dark --classic_prompt_separators=Slanted \
    --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat \
    --powerline_prompt_style="Two lines, character" --powerline_right_prompt_frame=Yes \
    --prompt_connection=Disconnected --prompt_connection_andor_frame_color=Dark \
    --prompt_spacing=Compact --show_time=No --icons="Many icons" --transient=Yes' \
    || warn "tide configure failed"
exit 0
{{- end }}
