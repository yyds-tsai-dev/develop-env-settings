{{- if and .isDesktop (eq .chezmoi.os "windows") -}}
# Windows Desktop: WezTerm, git, gh and VS Code through winget in user scope,
# and JetBrainsMono Nerd Font (latest Nerd Fonts release) into the per-user
# font dir. No admin rights: a package whose installer has no user scope is
# printed, at the end, as the elevated winget command to run. Already installed
# packages are skipped. Never aborts apply. A failed font download leaves a
# retry marker with a fresh nonce, so the next apply reruns this after every
# failure; a clean run removes it.
{{ template "retry-marker" (dict "chezmoi" .chezmoi "name" "70-desktop") }}
$ErrorActionPreference = 'Continue'
{{ template "retry-ps1" "70-desktop" }}
$failed = $false
$admin = @()

$packages = @('wez.wezterm', 'Git.Git', 'GitHub.cli', 'Microsoft.VisualStudioCode')
if (Get-Command winget -ErrorAction SilentlyContinue) {
    foreach ($id in $packages) {
        winget list --id $id -e --accept-source-agreements *> $null
        if ($LASTEXITCODE -eq 0) { continue }
        winget install --id $id -e --scope user --silent --accept-package-agreements --accept-source-agreements
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "winget could not install $id in user scope"
            $admin += "winget install --id $id -e --scope machine --accept-package-agreements --accept-source-agreements"
        }
    }
} else {
    Write-Warning 'winget not found; skipping WezTerm, git, gh and VS Code (install App Installer from the Microsoft Store)'
}

# --- JetBrainsMono Nerd Font (per-user fonts, no admin) ---
$fonts = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
$reg = 'HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
if (-not (Test-Path (Join-Path $fonts 'JetBrainsMonoNerdFont-Regular.ttf'))) {
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ('nerdfont-' + [guid]::NewGuid())
    try {
        New-Item -ItemType Directory -Force -Path $tmp, $fonts | Out-Null
        $zip = Join-Path $tmp 'JetBrainsMono.zip'
        Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip' -OutFile $zip
        Expand-Archive -Path $zip -DestinationPath (Join-Path $tmp 'x') -Force
        if (-not (Test-Path $reg)) { New-Item -Path $reg -Force | Out-Null }
        foreach ($f in Get-ChildItem -Path (Join-Path $tmp 'x') -Filter 'JetBrainsMonoNerdFont-*.ttf') {
            $dest = Join-Path $fonts $f.Name
            Copy-Item -Force $f.FullName $dest
            New-ItemProperty -Path $reg -Name "$($f.BaseName) (TrueType)" -Value $dest -PropertyType String -Force | Out-Null
        }
    } catch {
        Write-Warning "could not install JetBrainsMono Nerd Font (re-running the bootstrap one-liner retries): $_"
        $failed = $true
    } finally {
        Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
    }
}

if ($admin.Count -gt 0) {
    Write-Output 'These steps need admin rights; run them in an elevated PowerShell, then apply again:'
    $admin | ForEach-Object { Write-Output "  $_" }
}
if ($failed) { Set-RetryMarker } else { Clear-RetryMarker }
exit 0
{{- end }}
