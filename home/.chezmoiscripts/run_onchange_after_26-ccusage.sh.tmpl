{{- if and (or .isServer .isDesktop) (ne .chezmoi.os "windows") -}}
#!/bin/sh
# Installs ccusage {{ index .versions "ccusage" }} (Claude Code / Codex usage reports from local logs,
# e.g. `ccusage daily`) with npm through fnm's Node (no sudo), after the Node
# script (20-node). Its defaults (Asia/Taipei timezone) live in the managed
# ~/.config/claude/ccusage.json. ccusage is linked into ~/.local/bin (never
# over a regular file), where Doctor finds it without fnm's environment.
# Warns and exits 0 on any failure; never aborts apply. A failure leaves a retry
# marker with a fresh nonce, so the next apply (bin/update) reruns this script
# after every failure; success removes it.
{{ template "retry-marker" (dict "chezmoi" .chezmoi "name" "26-ccusage") }}
PATH="$HOME/.local/bin:$PATH"
export PATH
CC_VERSION="{{ index .versions "ccusage" }}"

warn() { echo "warning: $*" >&2; }
{{ template "retry-sh" "26-ccusage" }}
retry() { warn "$*"; retry_mark; exit 0; }

# Use fnm's default Node (npm global prefix then lives inside fnm's dir).
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --shell bash 2>/dev/null)" 2>/dev/null
    fnm use default >/dev/null 2>&1 || true
fi
command -v npm >/dev/null 2>&1 || retry "npm missing; skipping ccusage (bin/update retries)"

prefix="$(npm prefix -g 2>/dev/null)"
ncc="$prefix/bin/ccusage"
if [ "$("$ncc" --version 2>/dev/null)" != "ccusage $CC_VERSION" ]; then
    npm install -g "ccusage@$CC_VERSION" \
        || retry "could not install ccusage@$CC_VERSION (bin/update retries)"
fi
[ -x "$ncc" ] || retry "npm installed no $ncc (bin/update retries)"
# fnm env points npm at a per-shell symlink dir that fnm removes later: link
# the real dir, through fnm's `default` alias when there is one (as 20-node does).
bin="$(cd "$prefix/bin" 2>/dev/null && pwd -P)"
alias_bin="${bin%%/node-versions/*}/aliases/default/bin"
[ "$alias_bin" != "$bin/aliases/default/bin" ] && [ -x "$alias_bin/ccusage" ] && bin="$alias_bin"
[ -n "$bin" ] && ncc="$bin/ccusage"
if [ -e "$HOME/.local/bin/ccusage" ] && [ ! -L "$HOME/.local/bin/ccusage" ]; then
    warn "$HOME/.local/bin/ccusage is a regular file; not replacing it with a link to npm's ccusage"
else
    mkdir -p "$HOME/.local/bin" && ln -sfn "$ncc" "$HOME/.local/bin/ccusage"
fi
retry_clear
exit 0
{{- end }}
