{{- /* Every role off Windows (Linux Server, macOS Desktop and Desktop + Server);
Windows runs the PowerShell twin, run_onchange_after_50-claude.ps1. */ -}}
{{- if ne .chezmoi.os "windows" -}}
{{- $cbm := index .versions "codebase-memory-mcp" | default "" -}}
#!/bin/sh
# Claude Code: native install when missing, codebase-memory-mcp via its upstream
# installer (which writes its hooks, agents and skill), third-party skills,
# marketplaces and plugins from the Manifest, user-scope MCP servers at locked
# versions, then re-applies ~/.claude/settings.json because the cbm installer
# and `claude plugin marketplace add` rewrite it. Never logs in (Doctor checks
# the login). Warns and exits 0 on any failure; never aborts apply.
# An npx server (drawio) is started once with stdin closed before it is
# registered, so npx has the locked package in its cache and the first start
# fits in Claude's 30 s connect timeout.
{{- if not .isServer }}
# A plain Desktop registers only the MCP servers whose command exists there and
# installs an installer-made skill only when its installer exists; each one it
# skips prints one warning and is not a failure (no retry marker). A uvx server
# is run once with --help first (no uv tools here), so the first health check
# finds uv's cache warm.
{{- end }}
# Any warning (a download, an install, a prerequisite not there yet) leaves a
# retry marker holding a fresh nonce, so the next apply (bin/update) reruns this
# script after every failed run; a clean run removes it. (chezmoi keys run_onchange_ by name, so the apply after the one
# that removed the marker runs it once more: harmless, every step is idempotent.)
{{ template "retry-marker" (dict "chezmoi" .chezmoi "name" "50-claude") }}
# Locks: codebase-memory-mcp={{ $cbm }} graphifyy={{ index .versions "graphifyy" | default "" }}
# Codex bundle locks (a changed one re-runs this script so installed plugins are updated):{{ range .codex.skill_bundles }} {{ .name }}={{ index $.versions .name | default .ref }}{{ end }}
# Claude skill bundle locks:{{ range (index .claude "skill_bundles" | default list) }} {{ .name }}={{ index $.versions .name | default "" }}{{ end }}
PATH="$HOME/.local/bin:$PATH"
export PATH
cd "$HOME" || exit 0
# Bootstrap runs apply with stdin from /dev/tty (for chezmoi's prompts), and
# Claude Code's subcommands (plugin, mcp, auth) crash on macOS with
# "EINVAL: invalid argument, kqueue" when stdin is /dev/tty. Nothing here reads
# input, so stdin is /dev/null.
exec </dev/null

{{ template "retry-sh" "50-claude" }}
FAILED=
warn() { echo "warning: $*" >&2; FAILED=1; }
{{- if not .isServer }}
# skipped: a desktop lacks this runtime; not a failure.
skipped() { echo "warning: $*" >&2; }
{{- end }}
# prewarm help|stdin COMMAND [ARG]...: run the server command once, with --help
# (uvx: uv fetches Python and the package) or as is with stdin closed (an MCP
# stdio server exits at end of input; npx caches the package), stdin from
# /dev/null and a 15 min cap where `timeout` exists.
prewarm() {
    mode="$1"; shift
    [ "$mode" = help ] && set -- "$@" --help
    if command -v timeout >/dev/null 2>&1; then timeout 900 "$@" </dev/null >/dev/null 2>&1
    else "$@" </dev/null >/dev/null 2>&1; fi \
        || warn "could not pre-fetch the MCP server command: $*"
}
# done_or_retry: record the outcome for the next apply, then exit 0.
done_or_retry() {
    if [ -n "$FAILED" ]; then
        retry_mark
        echo "warning: 50-claude had failures; bin/update (or re-running bootstrap) retries it" >&2
    else
        retry_clear
    fi
    exit 0
}

# --- Claude Code (native installer, latest; it updates itself) ---
if ! claude --version >/dev/null 2>&1; then
    curl -fsSL https://claude.ai/install.sh | bash || warn "Claude Code native install failed"
fi
CLAUDE_OK=
if claude --version >/dev/null 2>&1; then CLAUDE_OK=1; else warn "claude missing; skipping plugins and MCP servers"; fi

# --- codebase-memory-mcp (upstream installer pinned to the lock) ---
# The installer rewrites settings.json hooks and registers the MCP server with an
# absolute path; both are put back below. --clients=claude: Codex is configured
# by its own managed config. It refuses a group/other-writable ~/.local or
# ~/.local/bin (umask 002 homes), so those two dirs are tightened first.
{{ template "local-bin-perms" }}
CBM_VERSION="{{ $cbm }}"
if [ "$(codebase-memory-mcp --version 2>/dev/null)" != "codebase-memory-mcp $CBM_VERSION" ] \
   && { [ -n "$CBM_VERSION" ] || ! command -v codebase-memory-mcp >/dev/null 2>&1; }; then
    if [ -n "$CBM_VERSION" ]; then
        ref="v$CBM_VERSION"; dl="https://github.com/DeusData/codebase-memory-mcp/releases/download/v$CBM_VERSION"
    else
        ref=main; dl="https://github.com/DeusData/codebase-memory-mcp/releases/latest/download"
    fi
    tmp="$(mktemp -d)"
    if curl -fsSL --retry 3 -o "$tmp/install.sh" "https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/$ref/install.sh"; then
        CBM_DOWNLOAD_URL="$dl" bash "$tmp/install.sh" --dir="$HOME/.local/bin" --clients=claude \
            || warn "codebase-memory-mcp $CBM_VERSION install failed"
    else
        warn "could not download the codebase-memory-mcp $ref installer"
    fi
    rm -rf "$tmp"
fi

# --- third-party skills ---
# fetch_skill DIR URL: install URL as ~/.claude/skills/DIR/SKILL.md
fetch_skill() {
    dst="$HOME/.claude/skills/$1/SKILL.md"
    tmp="$(mktemp)"
    if curl -fsSL --retry 3 -o "$tmp" "$2"; then
        mkdir -p "$HOME/.claude/skills/$1"
        cmp -s "$tmp" "$dst" || cat "$tmp" > "$dst"
    else
        warn "could not download skill $1 from $2"
    fi
    rm -f "$tmp"
}
{{- range .claude.skills }}
{{- if index . "url" }}
{{- $v := index $.versions (index . "version_from" | default .name) }}
{{- $ref := "main" }}{{ if $v }}{{ $ref = printf "v%s" $v }}{{ end }}
fetch_skill {{ .dir | squote }} {{ replace "{ref}" $ref .url | squote }}
{{- else if eq (index . "installer" | default "") "graphify" }}
if command -v graphify >/dev/null 2>&1; then
    # CLAUDE_CONFIG_DIR: graphify also writes its block into CLAUDE.md, which chezmoi
    # manages; install into a scratch dir and keep only the skill.
    tmp="$(mktemp -d)"
    if CLAUDE_CONFIG_DIR="$tmp" graphify install >/dev/null && [ -f "$tmp/skills/graphify/SKILL.md" ]; then
        rm -rf "$HOME/.claude/skills/graphify"
        mkdir -p "$HOME/.claude/skills/graphify"
        cp -R "$tmp/skills/graphify/." "$HOME/.claude/skills/graphify/"
    else
        warn "graphify install failed"
    fi
    rm -rf "$tmp"
else
{{- if $.isServer }}
    warn "graphify missing; skipping the graphify skill"
{{- else }}
    skipped "graphify not installed on this desktop; skipping the graphify skill"
{{- end }}
fi
{{- end }}
{{- end }}

# --- Claude skill bundles (allowlisted skills and agents from a repo tarball) ---
# cbundle NAME REPO REF VERSION SKILLS_DIR AGENTS_DIR SKILLS AGENTS: copy each
# allowlisted SKILLS_DIR/<skill>/ (whole dir) to ~/.claude/skills/<skill>/ and
# AGENTS_DIR/<agent>.md to ~/.claude/agents/, then record them in $CB/NAME
# ("version V", "skill N", "agent N"). A recorded entry that left the allowlist
# is removed; nothing unrecorded is ever removed. An unrecorded target that
# differs is moved to ~/.claude/.devenv-replaced/ first. The repo's own agents
# are never written. Nothing is fetched when the record already matches.
CB="$HOME/.local/state/develop-env/claude-bundles"
{{- $own := list }}
{{- range glob (joinPath .chezmoi.sourceDir "dot_claude/agents/*") }}{{ $own = append $own (base . | trimSuffix ".tmpl" | trimSuffix ".md") }}{{ end }}
OWN_AGENTS={{ join " " $own | squote }}
# cb_take SRC DST ENTRY: install SRC (dir or file) at DST unless identical.
cb_take() {
    if [ -e "$2" ]; then
        if [ -d "$1" ]; then diff -r "$1" "$2" >/dev/null 2>&1 && return 0
        else cmp -s "$1" "$2" && return 0; fi
        if ! printf '%s\n' "$cbold" | grep -qxF "$3"; then
            mkdir -p "$HOME/.claude/.devenv-replaced" \
                && mv "$2" "$HOME/.claude/.devenv-replaced/${2##*/}.$(date +%Y%m%d%H%M%S)" \
                || { warn "cannot move $2 aside"; return 1; }
        fi
    fi
    { rm -rf "$2.devenv-new" && cp -R "$1" "$2.devenv-new" && rm -rf "$2" && mv "$2.devenv-new" "$2"; } \
        || { warn "cannot install $2"; rm -rf "$2.devenv-new"; return 1; }
}
cbundle() {
    cbn="$1" cbrepo="$2" cbref="$3" cbver="$4" cbsd="$5" cbad="$6" cbskills="$7" cbagents="$8"
    cbst="$CB/$cbn"
    cbold="$(cat "$cbst" 2>/dev/null)"
    cbwant="version $cbver"
    for x in $cbskills; do cbwant="$cbwant
skill $x"; done
    for x in $cbagents; do cbwant="$cbwant
agent $x"; done
    if [ "$cbold" = "$cbwant" ]; then
        cbok=1
        for x in $cbskills; do [ -f "$HOME/.claude/skills/$x/SKILL.md" ] || cbok=; done
        for x in $cbagents; do [ -f "$HOME/.claude/agents/$x.md" ] || cbok=; done
        [ -n "$cbok" ] && return 0
    fi
    cbtmp="$(mktemp -d)"
    if ! { curl -fsSL --retry 3 -o "$cbtmp/b.tgz" "https://codeload.github.com/$cbrepo/tar.gz/$cbref" \
           && mkdir "$cbtmp/r" && tar -xzf "$cbtmp/b.tgz" -C "$cbtmp/r" --strip-components=1; }; then
        warn "could not fetch $cbrepo at $cbref"; rm -rf "$cbtmp"; return 0
    fi
    mkdir -p "$HOME/.claude/skills" "$HOME/.claude/agents"
    cbnew="version $cbver"
    for x in $cbskills; do
        if [ ! -f "$cbtmp/r/$cbsd/$x/SKILL.md" ]; then warn "bundle $cbn has no skill $cbsd/$x"; continue; fi
        cb_take "$cbtmp/r/$cbsd/$x" "$HOME/.claude/skills/$x" "skill $x" && cbnew="$cbnew
skill $x"
    done
    for x in $cbagents; do
        case " $OWN_AGENTS " in *" $x "*) warn "bundle $cbn: agent $x is one of this repo's own agents; not installed"; continue ;; esac
        if [ ! -f "$cbtmp/r/$cbad/$x.md" ]; then warn "bundle $cbn has no agent $cbad/$x.md"; continue; fi
        cb_take "$cbtmp/r/$cbad/$x.md" "$HOME/.claude/agents/$x.md" "agent $x" && cbnew="$cbnew
agent $x"
    done
    # recorded entries that left the allowlist (and only those) are removed
    printf '%s\n' "$cbold" | while read -r k x; do
        case "$k" in
            skill) case " $cbskills " in *" $x "*) ;; *) rm -rf "$HOME/.claude/skills/$x" ;; esac ;;
            agent) case " $cbagents $OWN_AGENTS " in *" $x "*) ;; *) rm -f "$HOME/.claude/agents/$x.md" ;; esac ;;
        esac
    done
    { mkdir -p "$CB" && printf '%s\n' "$cbnew" > "$cbst"; } || warn "cannot write $cbst"
    rm -rf "$cbtmp"
}
{{- range (index .claude "skill_bundles" | default list) }}
{{- $v := index $.versions .name | default "" }}
{{- if and (contains "{version}" .ref) (not $v) }}
warn {{ printf "%s: no locked version; skipped (run bin/update)" .name | squote }}
{{- else }}
cbundle {{ .name | squote }} {{ .repo | squote }} {{ replace "{version}" $v .ref | squote }} {{ $v | squote }} {{ .skills_dir | squote }} {{ .agents_dir | squote }} {{ join " " (index . "skills" | default list) | squote }} {{ join " " (index . "agents" | default list) | squote }}
{{- end }}
{{- end }}

if [ -n "$CLAUDE_OK" ]; then
    # --- marketplaces and plugins ---
    mkts="$(claude plugin marketplace list --json 2>/dev/null)"
    has_mkt() { printf '%s\n' "$mkts" | grep -qF "\"name\": \"$1\""; }
{{- range .claude.marketplaces }}
    has_mkt {{ .name | squote }} || claude plugin marketplace add {{ .repo | squote }} \
        || warn "could not add marketplace {{ .name }}"
    claude plugin marketplace update {{ .name | squote }} \
        || warn "could not update marketplace {{ .name }}"
{{- end }}
    plugins="$(claude plugin list --json 2>/dev/null)"
    has_plugin() { printf '%s\n' "$plugins" | grep -qF "\"id\": \"$1\""; }
    # a missing plugin is installed; an installed one is updated to its marketplace's
    # current version (the Codex bundles track upstream, so the two would drift)
{{- range .claude.plugins }}
    if has_plugin {{ .name | squote }}; then
        claude plugin update {{ .name | squote }} \
            || warn "could not update plugin {{ .name }}"
    else
        claude plugin install {{ .name | squote }} \
            || warn "could not install plugin {{ .name }}"
    fi
{{- end }}

fi

# --- MCP servers (user scope) ---
# mcp_server NAME COMMAND [ARG]...: register unless `claude mcp get` already
# shows the same command and args; a different registration is replaced.
mcp_server() {
    name="$1"; shift
    got="$(claude mcp get "$name" 2>/dev/null)" || got=
    cmd="$(printf '%s\n' "$got" | sed -n 's/^ *Command: //p')"
    args="$(printf '%s\n' "$got" | sed -n 's/^ *Args: *//p')"
    [ -n "$cmd" ] && [ "$cmd${args:+ $args}" = "$*" ] && return 0
    [ -n "$got" ] && claude mcp remove -s user "$name" >/dev/null 2>&1
    claude mcp add -s user "$name" -- "$@" >/dev/null || warn "could not add MCP server $name"
}
if [ -n "$CLAUDE_OK" ]; then
{{- range .mcp }}
{{- if has "claude" .clients }}
{{- $v := index $.versions .name }}
{{- $cl := .command | squote }}
{{- range .args }}{{ $cl = printf "%s %s" $cl (ternary (replace "{version}" ($v | toString) .) (. | replace "=={version}" "" | replace "@{version}" "@latest") (not (empty $v)) | squote) }}{{ end }}
{{- if not $.isServer }}
if ! command -v {{ .command | squote }} >/dev/null 2>&1; then
    skipped "{{ .command }} not found on this desktop; skipping MCP server {{ trimPrefix "mcp-" .name }}"
else
{{- if eq .command "uvx" }}
prewarm help {{ $cl }}
{{- end }}
{{- end }}
{{- if eq .command "npx" }}
prewarm stdin {{ $cl }}
{{- end }}
mcp_server {{ trimPrefix "mcp-" .name | squote }} {{ $cl }}
{{- if not $.isServer }}
fi
{{- end }}
{{- end }}
{{- end }}

# --- ARIS (aris@aris): its `codex` reviewer MCP server and ~/.aris/repo ---
# What the plugin's /aris:setup does, kept valid across plugin updates: the
# plugin root is a versioned cache dir, so the server is the bare
# aris-codex-mcp (~/.local/bin, managed), which starts server.py from the
# current installPath; ~/.aris/repo is re-pointed here and by that wrapper
# unless it names an ARIS clone outside the plugin cache. server.py needs
# Python 3.9+: python3, else uv's 3.12 (installed when missing).
aris_root="$(awk 'index($0, "\"aris@aris\": [") { f = 1; next }
    f && /"installPath":/ { sub(/.*"installPath": *"/, ""); sub(/".*/, ""); print; exit }' \
    "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null)"
if [ ! -f "$aris_root/mcp-servers/codex-exec/server.py" ]; then
    warn "aris@aris is not installed (no mcp-servers/codex-exec/server.py); skipping its codex MCP server"
else
    aris_cur="$(cat "$HOME/.aris/repo" 2>/dev/null)"
    case "$aris_cur" in
        "$aris_root") ;;
        "$HOME/.claude/plugins/cache/aris/"*|'') mkdir -p "$HOME/.aris" && printf '%s\n' "$aris_root" > "$HOME/.aris/repo" ;;
        *) [ -d "$aris_cur" ] || { mkdir -p "$HOME/.aris" && printf '%s\n' "$aris_root" > "$HOME/.aris/repo"; } ;;
    esac
    if ! { command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; } \
       && ! uv python find 3.12 >/dev/null 2>&1; then
        uv python install 3.12 >/dev/null 2>&1 || warn "no python3 3.9+ and uv could not install Python 3.12 for the ARIS codex MCP server"
    fi
    mcp_server codex aris-codex-mcp
fi
fi

# --- settings.json: the exact file chezmoi manages ---
settings="$HOME/.claude/settings.json"
want="$(mktemp)"
cat > "$want" <<'DEVENV_CLAUDE_SETTINGS'
{{ template "claude-settings.json" . -}}
DEVENV_CLAUDE_SETTINGS
if ! cmp -s "$want" "$settings"; then
    mkdir -p "$HOME/.claude"
    cat "$want" > "$settings"
fi
rm -f "$want"
done_or_retry
{{- end }}
