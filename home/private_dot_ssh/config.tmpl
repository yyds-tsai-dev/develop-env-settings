{{- /* Desktop only (see .chezmoiignore, which also skips it, leaving an existing
file untouched, while the vault is locked). Renders empty, so the file is not
created, when the ssh-hosts note is empty. */ -}}
{{- $note := includeTemplate "bw-field" (dict "chezmoi" .chezmoi "item" "ssh-hosts" "field" "notes") | trim -}}
{{- if $note -}}
# Managed by develop-env-settings (chezmoi) from the Bitwarden note ssh-hosts.
# Machine-specific settings go in ~/.ssh/config.local.
Include config.local
{{  range ($note | fromJson) }}
Host {{ .alias }}
    HostName {{ .hostname }}
{{- if .user }}
    User {{ .user }}
{{- end }}
    Port {{ .port | default 22 }}
{{ end -}}
{{- end -}}
