{{- /* SSH domains come from the Bitwarden note ssh-hosts (a JSON list of
{alias, hostname, user, port}); a locked or missing vault gives an empty list. */ -}}
{{- $note := includeTemplate "bw-field" (dict "chezmoi" .chezmoi "item" "ssh-hosts" "field" "notes") | trim -}}
{{- $hosts := list -}}
{{- if $note -}}{{- $hosts = $note | fromJson -}}{{- end -}}
-- Managed by develop-env-settings (chezmoi); edits here are overwritten on apply.
local wezterm = require 'wezterm'
local config = wezterm.config_builder()

config.font = wezterm.font 'JetBrainsMono Nerd Font'
-- Colour scheme: Catppuccin Mocha (built into WezTerm).
config.color_scheme = 'Catppuccin Mocha'

-- SSH domains from the Bitwarden note ssh-hosts (empty while the vault is locked;
-- unlock and apply again). Connecting attaches the tmux session "wez", which
-- survives disconnects and is separate from any VS Code tmux session.
{{- if $hosts }}
config.ssh_domains = {
{{- range $hosts }}
  {
    name = {{ .alias | toString | quote }},
    remote_address = {{ printf "%s:%v" (.hostname | toString) (.port | default 22) | quote }},
{{- if .user }}
    username = {{ .user | toString | quote }},
{{- end }}
    multiplexing = "None",
    default_prog = { "bash", "-lc", "tmux new -As wez" },
  },
{{- end }}
}
{{- else }}
config.ssh_domains = {}
{{- end }}

return config
