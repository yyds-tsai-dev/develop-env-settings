{{- /*
bw-field: returns one Secret field from the Bitwarden folder develop-env-settings.
Input: dict with item (item name) and field (custom field name, or notes /
username / password); .chezmoi must be passed as "chezmoi" (see bw-unlocked
callers: use `dict "chezmoi" .chezmoi ...`).
Silent: returns an empty string when bw is missing, locked, failing, or the
item/field does not exist. Skipping and warning is done by bw-ready, called
from .chezmoiignore, so an existing target file is left untouched.
*/ -}}
{{- $value := "" -}}
{{- if includeTemplate "bw-unlocked" . -}}
{{-   $folderId := "" -}}
{{-   range (output "sh" "-c" "bw list folders --search develop-env-settings 2>/dev/null || echo '[]'" | fromJson) -}}
{{-     if eq .name "develop-env-settings" -}}{{- $folderId = .id -}}{{- end -}}
{{-   end -}}
{{-   if $folderId -}}
{{-     range (output "sh" "-c" "bw list items --folderid \"$1\" --search \"$2\" 2>/dev/null || echo '[]'" "sh" $folderId .item | fromJson) -}}
{{-       if eq .name $.item -}}
{{-         if eq $.field "notes" -}}
{{-           $value = .notes | default "" -}}
{{-         else if eq $.field "username" -}}
{{-           $value = (.login | default dict).username | default "" -}}
{{-         else if eq $.field "password" -}}
{{-           $value = (.login | default dict).password | default "" -}}
{{-         else -}}
{{-           range (.fields | default list) -}}
{{-             if eq .name $.field -}}{{- $value = .value | default "" -}}{{- end -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $value -}}
