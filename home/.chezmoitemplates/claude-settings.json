{{- /*
claude-settings.json: ~/.claude/settings.json. Rendered by dot_claude/settings.json.tmpl
and re-applied by run_onchange_after_50-claude.sh (the codebase-memory-mcp installer and
`claude plugin marketplace add` rewrite the file). enabledPlugins and
extraKnownMarketplaces come from the Manifest; builtin marketplaces are not declared.
The cbm hooks call the wrapper scripts that installer writes to ~/.claude/hooks.
statusLine appears only once a statusline release is locked or the binary exists
(a local build), so Claude never runs a missing command.
On Windows the cbm installer writes .cmd shims and calls them through cmd.exe
(its cbm_build_claude_hook_command), so the hook commands take that form there.
*/ -}}
{{- $hook := `"\"$HOME/.claude/hooks/%s\""` }}
{{- if eq .chezmoi.os "windows" }}{{ $hook = `"cmd.exe /d /v:off /s /c '\"\"%%USERPROFILE%%\\.claude\\hooks\\%s.cmd\"\"'"` }}{{ end -}}
{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-code-discovery-gate" }},
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-code-discovery-gate" }},
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-session-reminder" }},
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-session-reminder" }},
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-session-reminder" }},
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-session-reminder" }},
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": {{ printf $hook "cbm-subagent-reminder" }},
            "timeout": 5
          }
        ]
      }
    ]
  },
{{- $slBin := printf "statusline-bin%s" (eq .chezmoi.os "windows" | ternary ".exe" "") }}
{{- if or (index .versions "statusline") (stat (joinPath .chezmoi.homeDir ".claude" $slBin)) }}
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/{{ $slBin }}\"",
    "refreshInterval": 60
  },
{{- end }}
  "enabledPlugins": {
{{- range $i, $p := .claude.plugins }}{{ if $i }},{{ end }}
    {{ $p.name | quote }}: true
{{- end }}
  },
  "extraKnownMarketplaces": {
{{- $first := true }}
{{- range .claude.marketplaces }}{{ if not (index . "builtin") }}{{ if not $first }},{{ end }}{{ $first = false }}
    {{ .name | quote }}: {
      "source": {
        "source": "github",
        "repo": {{ .repo | quote }}
      }
    }
{{- end }}{{ end }}
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
