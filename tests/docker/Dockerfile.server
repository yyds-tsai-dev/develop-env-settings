# Linux Server test image: a fresh Ubuntu with only curl, git and ca-certificates
# from the system package manager, and a non-root user `dev` without sudo.
# bzip2 is deliberately absent (the prereqs script must print, not run, the install).
FROM ubuntu:22.04
ARG UID=1000
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y curl git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# -l: no lastlog entry (large host UIDs would make a huge sparse file)
RUN useradd -l -m -u "$UID" -s /bin/bash dev
USER dev
WORKDIR /home/dev
