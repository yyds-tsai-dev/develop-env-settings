#!/usr/bin/env bash
# Doctor: runs every doctor.d/*.sh check. Usage: bin/doctor [--ci]
# Output per check: PASS <name> | FAIL <name>: <reason> | SKIP <name>: <reason>
# | WARN <name>: <reason> (advisory, does not fail)
# Exit status 1 if any check FAILs. --ci turns login and Secret checks into SKIP.
# DOCTOR_ONLY=<glob> sources only the doctor.d files whose name matches the glob
# (e.g. DOCTOR_ONLY='00-*'); unset means all. DEVENV_ROLE=<role> is the role
# when chezmoi cannot tell (no chezmoi, or no config yet).
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOCTOR_ROOT="$ROOT"
DOCTOR_CI=0
[ "${1:-}" = "--ci" ] && DOCTOR_CI=1
export DOCTOR_CI
# What to run to retry installs and re-apply: checks quote it in their hints.
# DOCTOR_FIX is enough when the owning install script failed (it left a retry
# marker, so the next apply reruns it) or a managed file is missing.
# DOCTOR_FORCE also reruns install scripts that succeeded earlier (their output
# was removed or broke later), which apply alone never reruns.
DOCTOR_FIX="run $ROOT/bin/update (or re-run bootstrap)"
DOCTOR_FORCE="run chezmoi state delete-bucket --bucket=entryState && $ROOT/bin/update"
export DOCTOR_FIX DOCTOR_FORCE

# Role: chezmoi's .role, else $DEVENV_ROLE, else server on Linux and desktop
# elsewhere. Exported as DOCTOR_ROLE; server-only checks call doctor_server_only.
# ~/.local/bin first (chezmoi, uv, bw and the tool links live there), before the
# role lookup below runs chezmoi.
PATH="$HOME/.local/bin:$PATH"; export PATH
if [ "$(uname -s)" = Darwin ]; then
  PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"; export PATH   # Homebrew tools
fi
DOCTOR_ROLE=
if command -v chezmoi >/dev/null 2>&1; then
  DOCTOR_ROLE="$(chezmoi execute-template '{{ .role }}' 2>/dev/null </dev/null)" || DOCTOR_ROLE=
fi
case "$DOCTOR_ROLE" in server|desktop|desktop+server) ;; *) DOCTOR_ROLE="${DEVENV_ROLE:-}" ;; esac
if [ -z "$DOCTOR_ROLE" ]; then
  if [ "$(uname -s)" = Linux ]; then DOCTOR_ROLE=server; else DOCTOR_ROLE=desktop; fi
fi
export DOCTOR_ROLE
doctor_server_only() {
  case "$DOCTOR_ROLE" in server|desktop+server) return 0 ;; esac
  echo "server role only (role: $DOCTOR_ROLE)"; return 2
}

DOCTOR_CHECKS=()
register() { DOCTOR_CHECKS+=("$1"); }
pass() { echo "PASS $1"; }
fail() { echo "FAIL $1: $2"; DOCTOR_FAILED=1; }
skip() { echo "SKIP $1: $2"; }
warn() { echo "WARN $1: $2"; }

# Checks call: check_x() { ...; return 0 on pass; print reason and return 1 on
# fail; print reason and return 2 on skip, 3 on warn. }
DOCTOR_FAILED=0
for f in "$ROOT"/doctor.d/*.sh; do
  [ -e "$f" ] || continue
  case "$(basename "$f")" in
    ${DOCTOR_ONLY:-*}) . "$f" ;;
  esac
done

# ${a[@]+...}: bash 3.2 (macOS) treats an empty array as unbound under set -u.
for name in ${DOCTOR_CHECKS[@]+"${DOCTOR_CHECKS[@]}"}; do
  label="${name#check_}"
  reason="$("$name" 2>&1)"; rc=$?
  case "$rc" in
    0) pass "$label" ;;
    2) skip "$label" "$reason" ;;
    3) warn "$label" "$reason" ;;
    *) fail "$label" "$reason" ;;
  esac
done

[ "$DOCTOR_FAILED" -eq 0 ]
